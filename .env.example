# Copy to .env for local development.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, include scheme, e.g. https://first5k.example.com
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# SQLite is used when unset. Production: postgres://user:pass@host:5432/db
DATABASE_URL=

# Email. Console backend is used automatically when DEBUG=True and EMAIL_BACKEND is empty.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=First5K <hello@example.com>

# Minimum days between block starts.
BLOCK_MIN_GAP_DAYS=2

# Optional privacy-friendly analytics (Plausible). Leave empty to disable.
PLAUSIBLE_DOMAIN=
